# AXIOM local operator configuration. Copy this file to .env and review every value.
# Never commit .env. The default refuses to make an offline-mode connection.

# The owner-authorised Aternos server from MASTER_PROJECT_CONTEXT.md.
AXIOM_MINECRAFT_HOST=ZCClanOnTOP.aternos.me
AXIOM_MINECRAFT_PORT=25565
AXIOM_MINECRAFT_VERSION=26.2
AXIOM_MINECRAFT_AUTH=offline

# This acknowledgement is deliberately required before an offline-mode client can connect.
# Set true only after you have confirmed this is your authorised offline-mode server.
AXIOM_OFFLINE_SERVER_AUTHORIZED=false
AXIOM_AUTHORIZED_OFFLINE_HOST=ZCClanOnTOP.aternos.me

# Begin at one live client. Raise only after a measured stability run at each stage.
AXIOM_MAX_LIVE_CONNECTIONS=1
AXIOM_ENABLED_BOTS=hsqoswqi,qojjosqsjiox,soiqsjowisjo,sqisoqwsi,sqosuqwos
AXIOM_LOGIN_STAGGER_MS=4000
AXIOM_VIEW_DISTANCE=4

# Reconnection is bounded. Aternos availability must be restored by a human operator.
AXIOM_RECONNECT_MAX_ATTEMPTS=5
AXIOM_RECONNECT_BASE_MS=5000
AXIOM_RECONNECT_MAX_MS=120000

# Resource governor thresholds for this worker process. Tune after real-device measurements.
AXIOM_MEMORY_SOFT_LIMIT_MB=350
AXIOM_MEMORY_CRITICAL_LIMIT_MB=450
AXIOM_EVENT_LOOP_SOFT_LIMIT_MS=150

# Incoming conversational replies are conservative. In-game administrative commands remain disabled.
AXIOM_CHAT_ENABLED=true
AXIOM_CHAT_PROACTIVE=false
AXIOM_CHAT_COOLDOWN_MS=7000
AXIOM_CHAT_GLOBAL_MAX_PER_MINUTE=3
AXIOM_CHAT_COMMANDS_ENABLED=false

# Keep false until the exact Mineflayer/minecraft-data/server tuple has been validated.
# This only permits a failed-closed experimental check in the explicitly authorised offline profile.
AXIOM_ALLOW_EXPERIMENTAL_PROTOCOL=false

# Logs and compact local death snapshots are written here.
AXIOM_DATA_DIR=./data
AXIOM_LOG_LEVEL=info
